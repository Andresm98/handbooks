{
  "name": "anaxdevbook",
  "version": "2.0.0",
  "private": true,
  "description": "Handbooks personales por temática, generados con Next.js a partir de content/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "validate": "tsx scripts/validate.ts",
    "prebuild": "npm run validate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t anaxdevbook:local .",
    "docker:up": "docker compose up --build web",
    "docker:dev": "docker compose --profile dev up --build dev"
  },
  "dependencies": {
    "next": "^16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
